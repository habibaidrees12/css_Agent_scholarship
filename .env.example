# Copy this file to .env if you want local settings.
# The starter project runs without a .env file.

# development or production. Reserved for later display and logging.
APP_ENV=development

# Folder that holds user_profile.json, relative to the project root unless absolute.
DATA_DIR=data

# Profile file name inside DATA_DIR.
PROFILE_FILENAME=user_profile.json

# Discovery files inside DATA_DIR.
SEARCH_CONFIG_FILENAME=search_config.json
PROFESSORS_FILENAME=professors.json

# Optional. OpenAlex does not require an API key.
# Add a contact email later if you enable live search and want the polite pool.
# OPENALEX_MAILTO=

# Official-page search. Use one provider. Leave both blank until you have a key.
# Keys are never written into the code. If both are empty, the agent reports
# "No configured search API." and does not pretend that search succeeded.
# SEARCH_PROVIDER=bing
BING_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Tavily Basic Search. Leave blank until you have a key.
TAVILY_API_KEY=

# Gmail OAuth. Leave these unset to use secrets/gmail_client_secret.json
# and secrets/gmail_token.json. Do not put the client secret or token here.
# GMAIL_CLIENT_SECRET_PATH=
# GMAIL_TOKEN_PATH=
# GMAIL_MOCK=1 uses a local mock and does not contact Gmail.